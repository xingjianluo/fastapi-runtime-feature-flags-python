{
  "db": {
    "host": "db.internal",
    "port": 5432,
    "pool_size": 20
  },
  "log_level": "info",
  "feature_flags": {
    "new_checkout": {
      "type": "bool",
      "default": false,
      "percentage": 0,
      "rules": [
        {
          "name": "staff_rollout",
          "effect": "on",
          "conditions": [
            {"attribute": "email", "op": "prefix", "value": "staff@"}
          ]
        }
      ]
    },
    "search_limit": {
      "type": "int",
      "default": 10,
      "percentage": 0
    }
  }
}
